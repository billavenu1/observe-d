{
  "uid": "od-gpu",
  "title": "observe-d / 01 GPU",
  "description": "8\u00d7H100 / 8\u00d7MI300X, vendor-neutral gpu:* metrics (normalize/gpu.yaml). 'n/a' = vendor has no equivalent.",
  "tags": [
    "observe-d",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
