    },
    {
      "type": "table",
      "title": "GPU \u2192 pod \u2192 model (latest)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT s.gpu_index AS gpu, s.vendor, s.gpu_model, s.node, s.pod, d.model, d.tp, round(s.compute_active_percent, 1) AS compute_pct, round(s.power_watts) AS watts, round(s.temp_celsius, 1) AS temp_c, s.throttle_reasons FROM (SELECT * FROM gpu_samples_v WHERE ts > now() - INTERVAL 2 MINUTE ORDER BY ts DESC LIMIT 1 BY gpu_uuid) AS s LEFT JOIN (SELECT * FROM model_deployments FINAL) AS d ON d.pod = s.pod ORDER BY toUInt32OrZero(gpu)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Inventory",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT gpu_uuid, vendor, gpu_model, node, gpu_index, formatReadableSize(mem_total_bytes) AS hbm, min(first_seen) AS first_seen, max(last_seen) AS last_seen FROM gpu_inventory GROUP BY gpu_uuid, vendor, gpu_model, node, gpu_index, mem_total_bytes ORDER BY node, toUInt32OrZero(gpu_index)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
