    {
      "type": "timeseries",
      "title": "SLO attainment by model (ClickHouse)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, model, sum(slo_good) / greatest(sum(requests), 1) AS slo_met FROM llm_rollup_1m FINAL WHERE $__timeFilter(minute) AND model != '' GROUP BY minute, model ORDER BY minute",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
