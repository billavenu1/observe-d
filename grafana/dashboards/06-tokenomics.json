      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT org_id, app_id, model, sum(requests) AS reqs, sum(tokens_in) AS in_tokens, sum(tokens_cached) AS cached, sum(tokens_out) AS out_tokens, round(sum(gpu_seconds) / 3600, 3) AS gpu_hours, round(sum(energy_j) / 3.6e6, 4) AS kwh, round(sum(cost_infra_usd), 4) AS infra_usd, round(sum(cost_list_usd), 4) AS list_price_usd, round(sum(cost_infra_usd) / greatest(sum(tokens_out), 1) * 1e6, 3) AS usd_per_1m_out, round(sum(slo_good) / greatest(sum(requests), 1), 4) AS goodput FROM tokenomics_hourly FINAL WHERE $__timeFilter(hour) GROUP BY org_id, app_id, model ORDER BY infra_usd DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
