# Simulator image: fake GPU exporter + simulated llm-d inference stack.
#   podman build -t localhost/observe-d-sim:dev -f sim/Containerfile .
FROM docker.io/library/python:3.12-slim

RUN pip install --no-cache-dir \
        "aiohttp>=3.10" "httpx>=0.27" "prometheus-client>=0.21" \
        "opentelemetry-sdk>=1.30" "opentelemetry-exporter-otlp-proto-grpc>=1.30"

WORKDIR /app
COPY sim /app/sim
ENV PYTHONUNBUFFERED=1
USER 65534
ENTRYPOINT ["python", "-m"]
CMD ["sim.inference_stack", "engine"]
