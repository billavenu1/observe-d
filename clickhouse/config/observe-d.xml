<clickhouse>
    <!-- Slim local profile: keep ClickHouse inside the 8 GB WSL budget. Production sizing: MVP.md §2.1 -->
    <max_server_memory_usage_to_ram_ratio>0.25</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <logger>
        <level>warning</level>
    </logger>
    <!-- Self-monitoring tables we don't need locally -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
</clickhouse>
